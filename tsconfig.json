{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist/js",
    "rootDir": "./src",
    "types": ["chrome", "node"]
  },
  "include": ["src/**/*"],
  "exclude": ["src/generate", "src/desktop/nw-polyfill.ts"]
}